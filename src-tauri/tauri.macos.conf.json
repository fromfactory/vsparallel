{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VSParallel",
        "width": 680,
        "height": 560,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "fullscreen": false,
        "visible": true,
        "backgroundColor": "#111114"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
